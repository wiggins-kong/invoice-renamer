{
  "name": "invoice-renamer",
  "version": "3.1.6",
  "description": "发票识别重命名桌面版（Electron）",
  "main": "main.js",
  "author": "wiggins",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "pdfjs-dist": "^4.8.69"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.local.invoice-renamer",
    "productName": "发票识别重命名",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "lib/**",
      "build/icon.ico",
      "package.json",
      "!node_modules/@napi-rs/**"
    ],
    "extraResources": [
      {
        "from": "tests/fixtures/",
        "to": "test-fixtures/",
        "filter": [
          "*.pdf"
        ]
      },
      {
        "from": "../samples/",
        "to": "samples/",
        "filter": [
          "*.pdf"
        ]
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "invoice-renamer.exe"
    },
    "nsis": {
      "artifactName": "invoice-renamer-setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "发票识别重命名"
    }
  }
}
